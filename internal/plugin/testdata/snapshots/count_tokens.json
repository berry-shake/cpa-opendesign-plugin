{
  "case": "count_tokens",
  "description": "Token counting and raw HTTP requests are not supported (501)",
  "setup": {
    "version": "9.9.9-snapshot",
    "config": {
      "base-url": "{{UPSTREAM}}",
      "data-dir": "{{DATA_DIR}}",
      "model-prefix": "opendesign"
    },
    "credentials": [
      {
        "name": "opendesign-k1.json",
        "fields": {
          "api_key": "sk-amr-snap-key-one-0001",
          "label": "Key One",
          "proxy_url": "direct",
          "type": "opendesign"
        }
      }
    ]
  },
  "upstream_script": [],
  "steps": [
    {
      "rpc": {
        "method": "executor.count_tokens",
        "request": {
          "Alt": "",
          "AuthAttributes": {
            "path": "/auths/opendesign-k1.json"
          },
          "AuthID": "opendesign-k1.json",
          "AuthMetadata": {
            "api_key": "sk-amr-snap-key-one-0001",
            "label": "Key One",
            "proxy_url": "direct",
            "type": "opendesign"
          },
          "AuthProvider": "opendesign",
