                "Go-http-client/1.1"
              ]
            },
            "body": "{\"capabilities\":{\"completionReceipt\":true},\"cliVersion\":\"0.1.10\",\"host\":\"cpa-snapshot-host\",\"profile\":\"prod\"}"
          },
          {
            "method": "POST",
            "path": "/api/v1/cli/device-authorizations/dev-1/token",
            "query": "",
            "header": {
              "Accept-Encoding": [
                "gzip"
              ],
              "Content-Length": [
                "63"
              ],
              "Content-Type": [
                "application/json"
              ],
              "User-Agent": [
                "Go-http-client/1.1"
              ]
