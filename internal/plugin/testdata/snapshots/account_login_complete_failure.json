        "upstream_requests": [],
        "host_calls": [],
        "response": {
          "ok": true,
          "result": {
            "Body": {
              "auth_index": "idx-1",
              "id": "<volatile>",
              "message": "confirm saved credentials: OpenDesign account API HTTP 500: internal_error: device authorization store unavailable",
              "state": "failed"
            },
            "Headers": {
              "Cache-Control": [
                "no-store"
              ],
              "Content-Type": [
                "application/json; charset=utf-8"
