{
  "case": "account_login_complete_failure",
  "description": "When /complete fails the auth file is restored and the new keys are revoked",
  "setup": {
    "version": "9.9.9-snapshot",
    "config": {
      "base-url": "{{UPSTREAM}}",
      "data-dir": "{{DATA_DIR}}",
      "model-prefix": "opendesign"
    },
    "credentials": [
      {
        "name": "opendesign-k1.json",
        "fields": {
          "api_key": "sk-amr-snap-key-one-0001",
          "label": "Key One",
          "proxy_url": "direct",
          "type": "opendesign"
        }
      }
    ]
  },
  "upstream_script": [
    {
      "method": "POST",
      "path": "/api/v1/cli/device-authorizations",
      "status": 201,
      "header": {
        "Content-Type": [
          "application/json"
        ]
      },
      "body": "{\"deviceId\":\"dev-1\",\"userCode\":\"WXYZ-1234\",\"deviceSecret\":\"secret-dev-1\",\"activationUrl\":\"https://open-design.ai/cli/activate?deviceId=dev-1\",\"pollIntervalSeconds\":1,\"status\":\"pending\",\"expiresAt\":\"2026-01-01T00:10:00Z\"}"
    },
    {
      "method": "POST",
      "path": "/api/v1/cli/device-authorizations/dev-1/token",
      "status": 200,
      "header": {
        "Content-Type": [
          "application/json"
        ]
      },
      "body": "{\"status\":\"approved\",\"controlKey\":\"ck-snap-new\",\"controlKeyId\":\"ck-snap-new-id\",\"runtimeKey\":\"rk-snap\",\"user\":{\"id\":\"user-1\",\"authUserId\":\"auth-1\",\"email\":\"me@example.com\",\"name\":\"Me\"},\"apiUrl\":\"\",\"linkUrl\":\"\"}"
    },
    {
      "method": "GET",
      "path": "/api/v1/workspaces",
      "status": 200,
      "header": {
        "Content-Type": [
          "application/json"
        ]
      },
      "body": "{\"items\":[{\"workspaceId\":\"ws-team\",\"workspaceName\":\"Team\",\"workspaceType\":\"team\",\"workspaceMemberId\":\"m1\",\"role\":\"owner\",\"memberStatus\":\"active\",\"lifecycleState\":\"active\",\"isDefault\":true},{\"workspaceId\":\"ws-me\",\"workspaceName\":\"Personal\",\"workspaceType\":\"personal\",\"workspaceMemberId\":\"m2\",\"role\":\"owner\",\"memberStatus\":\"active\",\"lifecycleState\":\"active\",\"isDefault\":false}]}"
    },
    {
      "method": "GET",
      "path": "/v1/models",
      "status": 200,
      "header": {
        "Content-Type": [
          "application/json"
        ]
      },
      "body": "{\"object\":\"list\",\"data\":[{\"id\":\"model-a\",\"object\":\"model\",\"created\":1767000000,\"owned_by\":\"opendesign\",\"architecture\":{\"input_modalities\":[\"text\",\"image\"],\"output_modalities\":[\"text\"]},\"metadata\":{\"cost\":\"Low\",\"capability\":\"standard\",\"context_limit\":200000,\"context_budget\":160000,\"output_budget\":32000},\"default\":true,\"enabled\":true},{\"id\":\"model-b\",\"object\":\"model\",\"created\":1767000001,\"owned_by\":\"opendesign\",\"architecture\":{\"input_modalities\":[\"text\"],\"output_modalities\":[\"text\"]},\"metadata\":{\"cost\":\"high\",\"capability\":\"reasoning\",\"context_limit\":128000,\"context_budget\":100000,\"output_budget\":16000},\"enabled\":true},{\"id\":\"image-gen\",\"object\":\"model\",\"created\":1767000002,\"owned_by\":\"opendesign\",\"architecture\":{\"input_modalities\":[\"text\"],\"output_modalities\":[\"image\"]},\"metadata\":{\"cost\":\"medium\"},\"enabled\":true}]}"
    },
    {
      "method": "POST",
      "path": "/api/v1/cli/device-authorizations/dev-1/complete",
      "status": 500,
      "header": {
        "Content-Type": [
          "application/json"
        ]
      },
      "body": "{\"error\":{\"code\":\"internal_error\",\"message\":\"device authorization store unavailable\"}}"
    },
    {
      "method": "POST",
      "path": "/api/v1/cli/logout",
      "status": 401,
      "header": {
        "Content-Type": [
          "application/json"
        ]
      },
      "body": "{\"error\":{\"code\":\"invalid_control_key\",\"message\":\"control key revoked\"}}"
    }
  ],
  "steps": [
    {
      "rpc": {
        "method": "management.handle",
        "request": {
          "Body": {
            "auth_index": "idx-1"
          },
          "Headers": {
            "Accept": [
              "application/json"
            ]
          },
          "Method": "POST",
          "Path": "/v0/management/plugins/opendesign/account/login",
          "Query": null,
          "host_callback_id": "cb-mgmt"
