        "host_calls": [
          {
            "method": "host.auth.list",
            "request": {}
          },
          {
            "method": "host.auth.get",
            "request": {
              "auth_index": "idx-1"
            }
          },
          {
            "method": "host.log",
            "request": {
              "fields": {
                "auth_index": "idx-1"
              },
              "level": "info",
              "message": "opendesign: account sign-in started"
            }
          },
          {
            "method": "host.auth.get",
            "request": {
              "auth_index": "idx-1"
            }
          },
          {
            "method": "host.auth.save",
            "request": {
              "json": {
                "account_control_key": "ck-snap-new",
                "account_control_key_id": "ck-snap-new-id",
                "account_email": "me@example.com",
                "account_logged_in_at": "2026-01-01T00:00:00Z",
                "account_name": "Me",
                "account_user_id": "user-1",
                "account_workspace_id": "ws-me",
                "account_workspace_name": "Personal",
                "api_key": "sk-amr-snap-key-one-0001",
                "label": "Key One",
                "proxy_url": "direct",
                "type": "opendesign"
              },
              "name": "opendesign-k1.json"
            }
          },
          {
            "method": "host.auth.save",
            "request": {
              "json": {
                "api_key": "sk-amr-snap-key-one-0001",
                "label": "Key One",
                "proxy_url": "direct",
                "type": "opendesign"
              },
              "name": "opendesign-k1.json"
            }
          },
          {
            "method": "host.log",
            "request": {
              "fields": {
                "auth_index": "idx-1",
                "error": "OpenDesign account API HTTP 401: invalid_control_key: control key revoked"
              },
              "level": "warn",
              "message": "opendesign: cannot revoke unsaved account keys"
            }
          }
        ],
        "response": {
          "ok": true,
          "result": {
            "Body": {
              "activation_url": "https://open-design.ai/cli/activate?deviceId=dev-1",
              "auth_index": "idx-1",
              "expires_at": "2026-01-01T00:10:00Z",
              "id": "<volatile>",
