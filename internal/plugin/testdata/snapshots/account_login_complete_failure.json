          {
            "method": "GET",
            "path": "/api/v1/workspaces",
            "query": "",
            "header": {
              "Accept-Encoding": [
                "gzip"
              ],
              "Authorization": [
                "Bearer ck-snap-new"
              ],
              "User-Agent": [
                "Go-http-client/1.1"
              ]
            },
            "body": ""
          },
          {
            "method": "GET",
            "path": "/v1/models",
            "query": "",
            "header": {
              "Accept": [
                "application/json"
              ],
              "Accept-Encoding": [
                "gzip"
              ],
              "Authorization": [
                "Bearer sk-amr-snap-key-one-0001"
              ],
              "User-Agent": [
                "cpa-opendesign-plugin/9.9.9-snapshot"
              ]
            },
            "body": ""
          },
          {
            "method": "POST",
            "path": "/api/v1/cli/device-authorizations/dev-1/complete",
            "query": "",
            "header": {
              "Accept-Encoding": [
                "gzip"
              ],
              "Content-Length": [
                "31"
