    {
      "rpc": {
        "method": "management.handle",
        "request": {
          "Body": null,
          "Headers": {
            "Accept": [
              "application/json"
            ]
          },
          "Method": "GET",
          "Path": "/v0/management/plugins/opendesign/proxies",
          "Query": null,
          "host_callback_id": "cb-mgmt"
        }
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [],
        "response": {
          "ok": true,
          "result": {
            "Body": {
