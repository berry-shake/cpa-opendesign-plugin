{
  "case": "management_proxies",
  "description": "The proxy list: empty, add (URL credentials redacted), duplicate and invalid input, rename, import the credentials' proxies, delete",
  "setup": {
    "version": "9.9.9-snapshot",
    "config": {
      "base-url": "{{UPSTREAM}}",
      "data-dir": "{{DATA_DIR}}",
      "model-prefix": "opendesign"
    },
    "credentials": [
      {
        "name": "opendesign-k1.json",
        "fields": {
          "api_key": "sk-amr-snap-key-one-0001",
          "label": "Key One",
          "proxy_url": "direct",
          "type": "opendesign"
        }
      },
      {
        "name": "opendesign-k2.json",
        "fields": {
          "api_key": "sk-amr-snap-key-two-0002",
          "models": [
            "model-b",
            "model-z"
          ],
          "note": "second key",
          "prefix": "od2",
          "priority": 2,
          "proxy_url": "socks5://user:secret@127.0.0.1:1080",
          "type": "opendesign"
        }
      }
    ]
  },
  "upstream_script": [],
