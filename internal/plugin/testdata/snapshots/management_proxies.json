              "Cache-Control": [
                "no-store"
              ],
              "Content-Type": [
                "application/json; charset=utf-8"
              ]
            },
            "StatusCode": 200
          }
        }
      }
    },
    {
      "rpc": {
        "method": "management.handle",
        "request": {
          "Body": {
            "name": "Tokyo",
            "url": "http://user:secret@127.0.0.1:9"
          },
          "Headers": {
            "Accept": [
              "application/json"
            ]
          },
          "Method": "POST",
          "Path": "/v0/management/plugins/opendesign/proxies",
          "Query": null,
          "host_callback_id": "cb-mgmt"
        }
      },
      "output": {
        "upstream_requests": [],
