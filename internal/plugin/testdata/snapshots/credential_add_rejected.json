{
  "case": "credential_add_rejected",
  "description": "A key the model list rejects is not saved; malformed input is refused before any request",
  "setup": {
    "version": "9.9.9-snapshot",
    "config": {
      "base-url": "{{UPSTREAM}}",
      "data-dir": "{{DATA_DIR}}",
      "model-prefix": "opendesign"
    },
    "credentials": [
      {
        "name": "opendesign-k1.json",
        "fields": {
          "api_key": "sk-amr-snap-key-one-0001",
          "label": "Key One",
          "proxy_url": "direct",
          "type": "opendesign"
        }
      }
    ]
  },
  "upstream_script": [
    {
      "method": "GET",
      "path": "/v1/models",
      "status": 401,
      "header": {
        "Content-Type": [
          "application/json"
        ]
      },
      "body": "{\"error\":{\"message\":\"Invalid API key\",\"code\":\"invalid_api_key\"}}"
    }
  ],
  "steps": [
    {
      "rpc": {
        "method": "management.handle",
        "request": {
          "Body": {
            "api_key": "sk-amr-snap-key-bad-0004"
          },
          "Headers": {
            "Accept": [
              "application/json"
            ]
          },
          "Method": "POST",
          "Path": "/v0/management/plugins/opendesign/credentials",
          "Query": null,
          "host_callback_id": "cb-mgmt"
        }
      },
      "output": {
        "upstream_requests": [
          {
            "method": "GET",
            "path": "/v1/models",
            "query": "",
            "header": {
              "Accept": [
                "application/json"
              ],
              "Accept-Encoding": [
                "gzip"
              ],
              "Authorization": [
                "Bearer sk-amr-snap-key-bad-0004"
              ],
              "User-Agent": [
                "cpa-opendesign-plugin/9.9.9-snapshot"
              ]
            },
            "body": ""
          }
        ],
        "host_calls": [
          {
            "method": "host.auth.list",
            "request": {}
          },
          {
            "method": "host.auth.get",
            "request": {
              "auth_index": "idx-1"
            }
          }
        ],
        "response": {
          "ok": true,
          "result": {
            "Body": {
              "error": "key_verification_failed",
              "message": "opendesign: Invalid API key"
            },
            "Headers": {
              "Cache-Control": [
                "no-store"
              ],
              "Content-Type": [
                "application/json; charset=utf-8"
              ]
            },
            "StatusCode": 400
          }
        }
      }
    },
    {
      "rpc": {
        "method": "management.handle",
        "request": {
          "Body": {
            "api_key": "has space"
          },
          "Headers": {
            "Accept": [
              "application/json"
            ]
          },
          "Method": "POST",
          "Path": "/v0/management/plugins/opendesign/credentials",
          "Query": null,
          "host_callback_id": "cb-mgmt"
        }
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [],
        "response": {
          "ok": true,
          "result": {
            "Body": {
              "error": "invalid_api_key",
              "message": "api_key is required and must not contain spaces"
            },
            "Headers": {
              "Cache-Control": [
                "no-store"
              ],
              "Content-Type": [
                "application/json; charset=utf-8"
              ]
            },
            "StatusCode": 400
          }
        }
      }
    },
    {
      "rpc": {
        "method": "management.handle",
        "request": {
          "Body": {
            "api_key": "sk-amr-snap-key-new-0003",
            "proxy_url": "ftp://proxy.invalid"
          },
          "Headers": {
            "Accept": [
              "application/json"
            ]
          },
          "Method": "POST",
          "Path": "/v0/management/plugins/opendesign/credentials",
          "Query": null,
          "host_callback_id": "cb-mgmt"
        }
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [
          {
            "method": "host.auth.list",
            "request": {}
          },
          {
            "method": "host.auth.get",
            "request": {
              "auth_index": "idx-1"
            }
          }
        ],
        "response": {
          "ok": true,
          "result": {
            "Body": {
              "error": "invalid_proxy",
              "message": "proxy_url: invalid proxy_url: unsupported scheme \"ftp\" (use http, https, socks5 or socks5h)"
            },
            "Headers": {
              "Cache-Control": [
                "no-store"
              ],
              "Content-Type": [
                "application/json; charset=utf-8"
              ]
            },
            "StatusCode": 400
          }
        }
      }
    },
    {
      "rpc": {
        "method": "management.handle",
        "request": {
          "Body": {
            "api_key": "sk-amr-snap-key-new-0003",
            "proxy_id": "missing"
          },
          "Headers": {
            "Accept": [
              "application/json"
            ]
          },
          "Method": "POST",
          "Path": "/v0/management/plugins/opendesign/credentials",
          "Query": null,
          "host_callback_id": "cb-mgmt"
        }
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [],
        "response": {
          "ok": true,
          "result": {
            "Body": {
              "error": "proxy_not_found",
              "message": "proxy_id does not match a listed proxy"
            },
            "Headers": {
              "Cache-Control": [
                "no-store"
              ],
              "Content-Type": [
                "application/json; charset=utf-8"
              ]
            },
            "StatusCode": 400
          }
        }
      }
    },
    {
      "rpc": {
        "method": "management.handle",
        "request": {
          "Body": "not json",
          "Headers": {
            "Accept": [
              "application/json"
            ]
          },
          "Method": "POST",
          "Path": "/v0/management/plugins/opendesign/credentials",
          "Query": null,
          "host_callback_id": "cb-mgmt"
        }
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [],
        "response": {
          "ok": true,
          "result": {
            "Body": {
              "error": "invalid_json",
              "message": "invalid character 'o' in literal null (expecting 'u')"
            },
            "Headers": {
              "Cache-Control": [
                "no-store"
              ],
              "Content-Type": [
                "application/json; charset=utf-8"
              ]
            },
            "StatusCode": 400
          }
        }
      }
    }
  ]
}
