          "StorageJSON": {
            "api_key": "sk-amr-snap-key-one-0001",
            "label": "Key One",
            "proxy_url": "direct",
            "type": "opendesign"
          },
          "Metadata": {
            "label": "Relabelled",
            "prefix": "mine"
          },
          "Attributes": null,
          "Host": {
            "AuthDir": "/auths",
            "ProxyURL": "",
            "ForceModelPrefix": false,
            "OAuthModelAlias": null,
            "ExcludedModels": null
          }
        }
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [],
        "response": {
          "ok": true,
          "result": {
            "Auth": {
              "Provider": "opendesign",
              "ID": "opendesign-k1.json",
              "FileName": "",
              "Label": "Relabelled",
              "Prefix": "mine",
              "ProxyURL": "direct",
              "Disabled": false,
              "StorageJSON": {
                "api_key": "sk-amr-snap-key-one-0001",
