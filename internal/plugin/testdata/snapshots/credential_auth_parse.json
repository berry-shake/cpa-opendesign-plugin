                "models": [
                  "model-b",
                  "model-z"
                ],
                "note": "second key",
                "prefix": "od2",
                "priority": 2,
                "type": "opendesign"
              },
              "Attributes": null,
              "NextRefreshAfter": "2027-01-02T03:04:05Z"
            },
            "Auths": null
          }
        }
      }
    },
    {
      "rpc": {
        "method": "auth.parse",
        "request": {
          "Provider": "codex",
          "Path": "/auths/codex-user.json",
          "FileName": "codex-user.json",
          "RawJSON": {
            "email": "user@example.com",
            "type": "codex"
          },
          "Host": {
            "AuthDir": "/auths",
            "ProxyURL": "",
            "ForceModelPrefix": false,
            "OAuthModelAlias": null,
            "ExcludedModels": null
          }
        }
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [],
        "response": {
          "ok": true,
          "result": {
            "Handled": false,
            "Auth": {
              "Provider": "",
              "ID": "",
              "FileName": "",
              "Label": "",
              "Prefix": "",
              "ProxyURL": "",
              "Disabled": false,
              "StorageJSON": null,
              "Metadata": null,
              "Attributes": null,
              "NextRefreshAfter": "0001-01-01T00:00:00Z"
            },
            "Auths": null
          }
        }
      }
    },
    {
      "rpc": {
        "method": "auth.parse",
        "request": {
          "Provider": "opendesign",
          "Path": "/auths/opendesign-nokey.json",
          "FileName": "opendesign-nokey.json",
          "RawJSON": {
            "label": "no key",
            "type": "opendesign"
          },
          "Host": {
            "AuthDir": "/auths",
            "ProxyURL": "",
            "ForceModelPrefix": false,
            "OAuthModelAlias": null,
