{
  "case": "credential_auth_parse",
  "description": "The auth RPCs CPA calls for files: parse (opendesign, other providers, no key), refresh with metadata, and the unsupported login flow",
  "setup": {
    "version": "9.9.9-snapshot",
    "config": {
      "base-url": "{{UPSTREAM}}",
      "data-dir": "{{DATA_DIR}}",
      "model-prefix": "opendesign"
    },
    "credentials": [
      {
        "name": "opendesign-k1.json",
        "fields": {
          "api_key": "sk-amr-snap-key-one-0001",
          "label": "Key One",
          "proxy_url": "direct",
          "type": "opendesign"
        }
      }
    ]
  },
  "upstream_script": [],
  "steps": [
    {
      "rpc": {
        "method": "auth.identifier",
        "request": {}
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [],
        "response": {
          "ok": true,
          "result": {
            "identifier": "opendesign"
          }
        }
      }
    },
    {
      "rpc": {
        "method": "auth.parse",
        "request": {
          "Provider": "opendesign",
          "Path": "/auths/opendesign-k2.json",
          "FileName": "opendesign-k2.json",
          "RawJSON": {
            "api_key": "sk-amr-snap-key-two-0002",
            "models": [
              "model-b",
              "model-z"
            ],
            "note": "second key",
            "prefix": "od2",
            "priority": 2,
            "type": "opendesign"
          },
          "Host": {
            "AuthDir": "/auths",
            "ProxyURL": "",
            "ForceModelPrefix": false,
            "OAuthModelAlias": null,
            "ExcludedModels": null
          }
        }
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [],
        "response": {
          "ok": true,
          "result": {
            "Handled": true,
            "Auth": {
              "Provider": "opendesign",
              "ID": "",
              "FileName": "opendesign-k2.json",
              "Label": "opendesign-k2",
              "Prefix": "od2",
              "ProxyURL": "",
              "Disabled": false,
              "StorageJSON": {
                "api_key": "sk-amr-snap-key-two-0002",
                "models": [
                  "model-b",
                  "model-z"
                ],
                "note": "second key",
                "prefix": "od2",
                "priority": 2,
