                "prefix": "mine",
                "proxy_url": "direct",
                "type": "opendesign"
              },
              "Metadata": {
                "api_key": "sk-amr-snap-key-one-0001",
                "label": "Relabelled",
                "prefix": "mine",
                "proxy_url": "direct",
                "type": "opendesign"
              },
              "Attributes": null,
              "NextRefreshAfter": "2027-01-02T03:04:05Z"
            },
            "NextRefreshAfter": "2027-01-02T03:04:05Z"
          }
        }
      }
    },
    {
      "rpc": {
        "method": "auth.login.start",
        "request": {
          "Provider": "opendesign",
          "BaseURL": "",
          "Host": {
            "AuthDir": "",
            "ProxyURL": "",
            "ForceModelPrefix": false,
            "OAuthModelAlias": null,
            "ExcludedModels": null
          },
          "Metadata": null
        }
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [],
        "response": {
          "ok": false,
          "error": {
            "code": "unsupported_login",
            "message": "OpenDesign uses API keys: add one on the OpenDesign plugin page or upload an opendesign auth file",
            "http_status": 400
          }
        }
      }
    },
    {
      "rpc": {
        "method": "auth.login.poll",
        "request": {
          "Provider": "opendesign",
          "State": "x",
          "Host": {
            "AuthDir": "",
            "ProxyURL": "",
            "ForceModelPrefix": false,
            "OAuthModelAlias": null,
            "ExcludedModels": null
          },
          "Metadata": null
        }
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [],
        "response": {
          "ok": true,
          "result": {
            "Status": "error",
            "Message": "OpenDesign uses API keys; there is no login flow",
            "Auth": {
              "Provider": "",
              "ID": "",
              "FileName": "",
              "Label": "",
              "Prefix": "",
              "ProxyURL": "",
              "Disabled": false,
              "StorageJSON": null,
              "Metadata": null,
              "Attributes": null,
              "NextRefreshAfter": "0001-01-01T00:00:00Z"
            },
            "Auths": null
          }
        }
      }
    }
  ]
}
