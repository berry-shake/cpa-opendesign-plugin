{
  "case": "credential_update",
  "description": "Editing a credential rewrites its auth file (label, models, prefix, priority, proxy, base URL); the key itself is immutable",
  "setup": {
    "version": "9.9.9-snapshot",
    "config": {
      "base-url": "{{UPSTREAM}}",
      "data-dir": "{{DATA_DIR}}",
      "model-prefix": "opendesign"
    },
    "credentials": [
      {
        "name": "opendesign-k1.json",
        "fields": {
          "api_key": "sk-amr-snap-key-one-0001",
          "label": "Key One",
          "proxy_url": "direct",
          "type": "opendesign"
        }
      },
      {
        "name": "opendesign-k2.json",
        "fields": {
          "api_key": "sk-amr-snap-key-two-0002",
          "models": [
            "model-b",
            "model-z"
          ],
          "note": "second key",
          "prefix": "od2",
          "priority": 2,
          "type": "opendesign"
        }
      }
    ]
  },
  "upstream_script": [
    {
      "method": "GET",
      "path": "/v1/models",
      "status": 200,
      "header": {
        "Content-Type": [
          "application/json"
        ]
      },
      "body": "{\"object\":\"list\",\"data\":[{\"id\":\"model-b\",\"object\":\"model\",\"created\":1767000001,\"owned_by\":\"opendesign\",\"architecture\":{\"input_modalities\":[\"text\"],\"output_modalities\":[\"text\"]},\"metadata\":{\"cost\":\"high\",\"capability\":\"reasoning\",\"context_limit\":128000,\"context_budget\":100000,\"output_budget\":16000},\"enabled\":true},{\"id\":\"model-c\",\"object\":\"model\",\"created\":1767000003,\"owned_by\":\"opendesign\",\"architecture\":{\"input_modalities\":[\"text\",\"application/pdf\"],\"output_modalities\":[\"text\"]},\"metadata\":{\"cost\":\"medium\",\"capability\":\"standard\",\"context_limit\":64000,\"context_budget\":60000,\"output_budget\":8000},\"enabled\":false}]}"
    }
  ],
  "steps": [
    {
      "rpc": {
        "method": "management.handle",
        "request": {
          "Body": {
            "auth_index": "idx-2",
            "base_url": "{{UPSTREAM}}/v1/",
            "label": "Renamed",
            "models": null,
            "note": "",
            "prefix": null,
            "priority": 3,
            "proxy_url": "direct"
          },
          "Headers": {
            "Accept": [
              "application/json"
            ]
          },
          "Method": "PATCH",
          "Path": "/v0/management/plugins/opendesign/credentials",
          "Query": null,
          "host_callback_id": "cb-mgmt"
        }
      },
      "output": {
        "upstream_requests": [
          {
            "method": "GET",
            "path": "/v1/models",
            "query": "",
            "header": {
              "Accept": [
                "application/json"
              ],
              "Accept-Encoding": [
                "gzip"
              ],
              "Authorization": [
                "Bearer sk-amr-snap-key-two-0002"
              ],
              "User-Agent": [
                "cpa-opendesign-plugin/9.9.9-snapshot"
              ]
            },
            "body": ""
          }
        ],
        "host_calls": [
          {
            "method": "host.auth.list",
            "request": {}
          },
          {
            "method": "host.auth.get",
            "request": {
              "auth_index": "idx-1"
            }
          },
          {
            "method": "host.auth.get",
            "request": {
              "auth_index": "idx-2"
            }
          },
          {
