                "failed": 0,
                "id": "opendesign-k2.json",
                "key_id": "9687cdae8c",
                "key_masked": "sk-amr…0002",
                "label": "Renamed",
                "listed_models": 1,
                "models": [],
                "name": "opendesign-k2.json",
                "prefix": null,
                "priority": 3,
                "proxy_url": "direct",
                "registered_known": true,
                "registered_models": 1,
                "success": 0,
                "unavailable": false
              },
              "ok": true
            },
            "Headers": {
              "Cache-Control": [
                "no-store"
              ],
              "Content-Type": [
                "application/json; charset=utf-8"
              ]
            },
            "StatusCode": 200
          }
        }
      }
    },
    {
      "rpc": {
        "method": "management.handle",
        "request": {
          "Body": {
            "api_key": "sk-amr-snap-key-new-0003",
            "auth_index": "idx-2"
          },
          "Headers": {
            "Accept": [
              "application/json"
            ]
          },
          "Method": "PATCH",
          "Path": "/v0/management/plugins/opendesign/credentials",
          "Query": null,
          "host_callback_id": "cb-mgmt"
