        "upstream_requests": [],
        "host_calls": [
          {
            "method": "host.auth.list",
            "request": {}
          },
          {
            "method": "host.auth.get",
            "request": {
              "auth_index": "idx-1"
            }
          },
          {
            "method": "host.auth.get",
            "request": {
              "auth_index": "idx-2"
            }
          }
        ],
        "response": {
          "ok": true,
          "result": {
            "Body": {
              "error": "credential_not_found",
