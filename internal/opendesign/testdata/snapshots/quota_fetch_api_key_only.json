{
  "case": "quota_fetch_api_key_only",
  "description": "quota.fetch for a key without a signed-in account, another provider, no auth_index and an unknown one",
  "setup": {
    "version": "9.9.9-snapshot",
    "config": {
      "base-url": "{{UPSTREAM}}",
      "data-dir": "{{DATA_DIR}}",
      "model-prefix": "opendesign"
    },
    "credentials": [
      {
        "name": "opendesign-k1.json",
        "fields": {
          "api_key": "sk-amr-snap-key-one-0001",
          "label": "Key One",
          "proxy_url": "direct",
          "type": "opendesign"
        }
      }
    ]
  },
  "upstream_script": [],
  "steps": [
    {
      "rpc": {
        "method": "quota.fetch",
        "request": {
          "auth_index": "idx-1",
          "auth_id": "opendesign-k1.json",
          "provider": "opendesign",
          "storage_json": {
            "api_key": "sk-amr-snap-key-one-0001",
            "label": "Key One",
            "proxy_url": "direct",
            "type": "opendesign"
          },
          "metadata": {
            "api_key": "sk-amr-snap-key-one-0001",
            "label": "Key One",
            "proxy_url": "direct",
            "type": "opendesign"
          },
          "host": {
            "AuthDir": "/auths",
            "ProxyURL": "",
            "ForceModelPrefix": false,
            "OAuthModelAlias": null,
            "ExcludedModels": null
          },
          "host_callback_id": "cb-quota"
        }
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [
          {
            "method": "host.auth.list",
            "request": {}
          },
          {
            "method": "host.auth.get",
            "request": {
              "auth_index": "idx-1"
            }
          }
        ],
        "response": {
          "ok": false,
          "error": {
            "code": "account_not_signed_in",
            "message": "OpenDesign API keys report no allowance; sign an OpenDesign account in on this key's card on the OpenDesign plugin page to show the plan's 5-hour and 7-day windows",
            "http_status": 404
          }
        }
      }
    },
    {
      "rpc": {
        "method": "quota.fetch",
        "request": {
          "auth_index": "idx-1",
          "auth_id": "opendesign-k1.json",
          "provider": "codex",
          "storage_json": {
            "api_key": "sk-amr-snap-key-one-0001",
            "label": "Key One",
            "proxy_url": "direct",
            "type": "opendesign"
          },
          "metadata": {
            "api_key": "sk-amr-snap-key-one-0001",
            "label": "Key One",
            "proxy_url": "direct",
            "type": "opendesign"
          },
          "host": {
            "AuthDir": "/auths",
            "ProxyURL": "",
            "ForceModelPrefix": false,
            "OAuthModelAlias": null,
            "ExcludedModels": null
          },
          "host_callback_id": "cb-quota"
        }
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [],
        "response": {
          "ok": false,
          "error": {
            "code": "invalid_request",
            "message": "not an OpenDesign credential",
            "http_status": 400
          }
        }
      }
    },
    {
      "rpc": {
        "method": "quota.fetch",
        "request": {
          "auth_index": "",
          "auth_id": "opendesign-k1.json",
          "provider": "opendesign",
          "storage_json": {
            "api_key": "sk-amr-snap-key-one-0001",
            "label": "Key One",
            "proxy_url": "direct",
            "type": "opendesign"
          },
          "metadata": {
            "api_key": "sk-amr-snap-key-one-0001",
            "label": "Key One",
            "proxy_url": "direct",
            "type": "opendesign"
          },
          "host": {
            "AuthDir": "/auths",
            "ProxyURL": "",
            "ForceModelPrefix": false,
            "OAuthModelAlias": null,
            "ExcludedModels": null
          },
          "host_callback_id": "cb-quota"
        }
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [],
        "response": {
          "ok": false,
          "error": {
            "code": "invalid_request",
            "message": "auth_index is required",
            "http_status": 400
          }
        }
      }
    },
    {
      "rpc": {
        "method": "quota.fetch",
        "request": {
          "auth_index": "idx-9",
          "auth_id": "gone.json",
          "provider": "opendesign",
          "storage_json": {
            "api_key": "sk-amr-snap-key-one-0001",
            "label": "Key One",
            "proxy_url": "direct",
            "type": "opendesign"
          },
          "metadata": {
            "api_key": "sk-amr-snap-key-one-0001",
            "label": "Key One",
            "proxy_url": "direct",
            "type": "opendesign"
          },
          "host": {
            "AuthDir": "/auths",
            "ProxyURL": "",
            "ForceModelPrefix": false,
            "OAuthModelAlias": null,
            "ExcludedModels": null
          },
          "host_callback_id": "cb-quota"
        }
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [
          {
            "method": "host.auth.list",
            "request": {}
          },
          {
            "method": "host.auth.get",
            "request": {
              "auth_index": "idx-1"
            }
          }
        ],
        "response": {
          "ok": false,
          "error": {
            "code": "credential_not_found",
            "message": "no OpenDesign credential matches auth_index",
            "http_status": 404
          }
        }
      }
    }
  ]
}
